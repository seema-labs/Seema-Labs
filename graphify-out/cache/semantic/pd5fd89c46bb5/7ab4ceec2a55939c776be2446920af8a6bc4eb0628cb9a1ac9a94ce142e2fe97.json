{"nodes": [{"id": "sites_trinetra_logo_mark", "label": "Trinetra Logo Mark", "file_type": "image", "source_file": "sites/trinetra/logo.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single-line SVG mark on a 40 by 40 viewBox. No text, title, description, or circle elements. A filled purple diamond is centered, and a group of three thick open corner strokes in the same purple surrounds it."}, {"id": "sites_trinetra_logo_central_diamond", "label": "Central Purple Diamond", "file_type": "image", "source_file": "sites/trinetra/logo.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filled path d='m20 15 5 5-5 5-5-5z' with fill #7960dc and no stroke. Vertices are (20,15), (25,20), (20,25), and (15,20): a square rotated 45 degrees, centered at (20,20), with horizontal and vertical diagonals of length 10."}, {"id": "sites_trinetra_logo_corner_strokes", "label": "Three Open Corner Strokes", "file_type": "image", "source_file": "sites/trinetra/logo.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A group element with fill none, stroke #7960dc, stroke-width 5, and stroke-linejoin round. It contains exactly three open path strokes and no closed shapes."}, {"id": "sites_trinetra_logo_top_left_corner", "label": "Top-Left Right-Angle Corner", "file_type": "image", "source_file": "sites/trinetra/logo.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Path d='M18 5H6v12': polyline (18,5) to (6,5) to (6,17). The vertex is (6,5). One arm runs east and the other south, an exact 90-degree corner at the top-left of the canvas."}, {"id": "sites_trinetra_logo_right_corner", "label": "Right Corner Stroke", "file_type": "image", "source_file": "sites/trinetra/logo.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Path d='M23 7l11 7-6 11': polyline (23,7) to (34,14) to (28,25). The outer vertex is (34,14), on the right. The interior angle is about 94 degrees."}, {"id": "sites_trinetra_logo_bottom_corner", "label": "Bottom Corner Stroke", "file_type": "image", "source_file": "sites/trinetra/logo.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Path d='M8 24l6 11 12-6': polyline (8,24) to (14,35) to (26,29). The outer vertex is (14,35), at the bottom. The interior angle is about 92 degrees."}, {"id": "sites_trinetra_logo_purple", "label": "Purple #7960dc", "file_type": "concept", "source_file": "sites/trinetra/logo.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only color in the file. Hex #7960dc (RGB 121, 96, 220) is the group stroke and the diamond fill. No other fills, strokes, or gradients appear."}, {"id": "sites_trinetra_logo_viewbox", "label": "40 by 40 ViewBox", "file_type": "concept", "source_file": "sites/trinetra/logo.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Root svg viewBox is '0 0 40 40'. The root has no width or height attributes, so the mark is a square coordinate system that scales with its container."}, {"id": "sites_trinetra_logo_stroke_style", "label": "Thick Round Stroke", "file_type": "concept", "source_file": "sites/trinetra/logo.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The corner group sets fill to none, stroke-width to 5, and stroke-linejoin to round. Width 5 is one-eighth of the 40-unit canvas, so the corners are heavy strokes with rounded joins. The diamond path does not use this stroke."}, {"id": "sites_trinetra_logo_three_eyes", "label": "Three Eyes Reading", "file_type": "concept", "source_file": "sites/trinetra/logo.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uncertain reading, flagged for review. The file path names the mark trinetra, and the drawing has three corner strokes, but the SVG contains no text and the strokes are open right-angle corners rather than drawn eyes."}], "edges": [{"source": "sites_trinetra_logo_corner_strokes", "target": "sites_trinetra_logo_mark", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sites/trinetra/logo.svg", "source_location": null, "weight": 1.0}, {"source": "sites_trinetra_logo_central_diamond", "target": "sites_trinetra_logo_mark", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sites/trinetra/logo.svg", "source_location": null, "weight": 1.0}, {"source": "sites_trinetra_logo_top_left_corner", "target": "sites_trinetra_logo_corner_strokes", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sites/trinetra/logo.svg", "source_location": null, "weight": 1.0}, {"source": "sites_trinetra_logo_right_corner", "target": "sites_trinetra_logo_corner_strokes", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sites/trinetra/logo.svg", "source_location": null, "weight": 1.0}, {"source": "sites_trinetra_logo_bottom_corner", "target": "sites_trinetra_logo_corner_strokes", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sites/trinetra/logo.svg", "source_location": null, "weight": 1.0}, {"source": "sites_trinetra_logo_corner_strokes", "target": "sites_trinetra_logo_purple", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sites/trinetra/logo.svg", "source_location": null,