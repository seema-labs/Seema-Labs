{"nodes": [{"id": "readme_seema_labs", "label": "Seema Labs", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The company whose work is defining clear boundaries for autonomous AI systems. The name Seema means boundary or limit, and the connection to Nepal is meant to be preserved."}, {"id": "readme_trinetra", "label": "Trinetra", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seema Labs' first product. Company-site links to Trinetra are required to point at the existing hosted Trinetra website."}, {"id": "readme_seema_labs_website", "label": "Seema Labs Website", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Static site in sites/seema-labs/, previewed at http://127.0.0.1:4174 via npm start. Existing host is https://seema-labs.zestycream11.chatgpt.site. No package install or build step; fonts come from Google Fonts with system fallbacks."}, {"id": "readme_trinetra_website", "label": "Trinetra Website", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Static site in sites/trinetra/, previewed at http://127.0.0.1:4173 via npm run preview:trinetra. Existing host is https://trinetra-focused-access.zestycream11.chatgpt.site."}, {"id": "readme_autonomy_not_unlimited_authority", "label": "Give AI Autonomy, Not Unlimited Authority", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repository thesis: grant AI room to act while refusing unlimited authority."}, {"id": "readme_nepal", "label": "Nepal", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The company's connection to Nepal, and the Nepali meaning of Seema as boundary or limit, must be preserved in the sites."}, {"id": "readme_illustrative_browser_examples", "label": "Illustrative Browser-Only Examples", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Permission plans and approval controls are illustrative browser-only examples. They do not grant real access or contact a backend."}, {"id": "readme_content_integrity", "label": "Content Integrity Guideline", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do not invent customers, testimonials, pricing, contact details, certifications, or product guarantees."}, {"id": "readme_accessibility", "label": "Accessibility and Responsive Layout", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keyboard navigation, visible focus states, reduced-motion support, and responsive layouts must stay intact, and interactive controls should be reviewed in a browser before publishing."}, {"id": "readme_static_hosting", "label": "Static Hosting", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each website folder can be uploaded to a static host with index.html at the serving root. Pushing to GitHub does not update the existing hosted sites. Hosting credentials are omitted, and GitHub Pages is not enabled."}, {"id": "readme_local_preview", "label": "Local Preview", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires Node.js 18 or newer. npm start serves Seema Labs on port 4174; npm run preview:trinetra serves Trinetra on port 4173. PORT overrides the port. No npm install is needed."}, {"id": "readme_asset_check", "label": "npm run check", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verifies local assets, section links, unique HTML IDs, and JavaScript syntax before publishing."}, {"id": "readme_google_fonts", "label": "Google Fonts", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fonts load from Google Fonts with system fallbacks so the static sites need no package dependencies or build step."}], "edges": [{"source": "readme_seema_labs", "target": "readme_trinetra", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_seema_labs", "target": "readme_seema_labs_website", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_trinetra", "target": "readme_trinetra_website", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_seema_labs", "target": "readme_trinetra_website", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_autonomy_not_unlimited_authority", "target": "readme_seema_labs", "relation": "rationale