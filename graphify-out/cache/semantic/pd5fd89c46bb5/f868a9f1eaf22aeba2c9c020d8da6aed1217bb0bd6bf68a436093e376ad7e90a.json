{"nodes": [{"id": "sites_seema_labs_logo_mark", "label": "Seema Labs Logo Mark", "file_type": "image", "source_file": "sites/seema-labs/logo.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "40 by 40 SVG mark with no text and no circles. Two unfilled paths share one group: stroke #d55b35, stroke-width 4, square line caps. The drawing is a left squared bracket, a split right stem, and a horizontal bar through the middle."}, {"id": "sites_seema_labs_logo_squared_bracket", "label": "Left Squared Bracket", "file_type": "concept", "source_file": "sites/seema-labs/logo.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First subpath M25 5H6v30h19. A square-cornered C opening right: top arm from (25,5) to (6,5), spine down to (6,35), bottom arm back to (25,35)."}, {"id": "sites_seema_labs_logo_split_stem", "label": "Split Right Stem", "file_type": "concept", "source_file": "sites/seema-labs/logo.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same path continues M34 5v11 and M34 25v10. Two vertical ticks at x=34, from y=5 to y=16 and from y=25 to y=35, with a gap between y=16 and y=25."}, {"id": "sites_seema_labs_logo_crossbar", "label": "Center Crossbar", "file_type": "concept", "source_file": "sites/seema-labs/logo.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Second path M15 20h23. Horizontal stroke from (15,20) to (38,20). It starts inside the left bracket, whose arms end at x=25, and runs through the right stem's gap, ending four units past x=34."}, {"id": "sites_seema_labs_logo_terracotta_stroke", "label": "Burnt Orange Stroke #d55b35", "file_type": "concept", "source_file": "sites/seema-labs/logo.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parent group sets fill none, stroke #d55b35 (burnt orange), stroke-width 4, and stroke-linecap square, so every segment is a thick blunt stroke with no fill."}, {"id": "sites_seema_labs_logo_bracket_motif", "label": "Bracket Monogram Motif", "file_type": "concept", "source_file": "sites/seema-labs/logo.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The three strokes read as an opening square bracket, a broken closing bracket, and a hyphen through the gap, like a code or prompt glyph. The file does not name that reading."}, {"id": "sites_seema_labs_logo_letter_e", "label": "Possible Block Letter E", "file_type": "concept", "source_file": "sites/seema-labs/logo.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uncertain alternate reading as a block E: left spine, short top and bottom arms, a longer middle bar, and detached right ticks. The ticks do not join the arms (gap from x=25 to x=34), and the file has no letter or title."}], "edges": [{"source": "sites_seema_labs_logo_mark", "target": "sites_seema_labs_logo_squared_bracket", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sites/seema-labs/logo.svg", "source_location": null, "weight": 1.0}, {"source": "sites_seema_labs_logo_mark", "target": "sites_seema_labs_logo_split_stem", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sites/seema-labs/logo.svg", "source_location": null, "weight": 1.0}, {"source": "sites_seema_labs_logo_mark", "target": "sites_seema_labs_logo_crossbar", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sites/seema-labs/logo.svg", "source_location": null, "weight": 1.0}, {"source": "sites_seema_labs_logo_mark", "target": "sites_seem