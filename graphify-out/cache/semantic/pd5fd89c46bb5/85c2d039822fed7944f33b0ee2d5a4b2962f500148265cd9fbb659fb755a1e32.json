{"nodes": [{"id": "sites_seema_labs_index_seema_labs", "label": "Seema Labs", "file_type": "concept", "source_file": "sites/seema-labs/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named Seema, Nepali for boundary or limit, because the company defines clear boundaries for autonomous AI. Agents should have enough freedom for meaningful work while staying inside those limits."}, {"id": "sites_seema_labs_index_trinetra", "label": "Trinetra", "file_type": "concept", "source_file": "sites/seema-labs/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First product: the boundary brought to the coding task. It turns a coding task into focused permissions, explains why each permission is needed, and leaves approval with people."}, {"id": "sites_seema_labs_index_hosted_trinetra", "label": "Hosted Trinetra Site", "file_type": "document", "source_file": "sites/seema-labs/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Outbound product links use https://trinetra-focused-access.zestycream11.chatgpt.site rather than an in-repo route."}, {"id": "sites_seema_labs_index_autonomy_not_unlimited_authority", "label": "Give AI Autonomy, Not Unlimited Authority", "file_type": "rationale", "source_file": "sites/seema-labs/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Useful AI needs room to work and clear limits. Organizations define the boundaries of authority for autonomous systems. Closing line: build for autonomy and be deliberate about authority."}, {"id": "sites_seema_labs_index_defined_task_boundary", "label": "Defined Task Boundary", "file_type": "concept", "source_file": "sites/seema-labs/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hero diagram: AI activity stays inside a defined task boundary, with freedom to act within scope. Asking for more authority is a human decision. Marked as an illustrative concept so delegation stays deliberate."}, {"id": "sites_seema_labs_index_nepal", "label": "Nepal", "file_type": "concept", "source_file": "sites/seema-labs/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The name story pairs Nepali roots (\u0938\u0940\u092e\u093e / Seema) with the problem of bounding useful AI autonomy."}, {"id": "sites_seema_labs_index_ai_coding_agents", "label": "AI Coding Agents", "file_type": "concept", "source_file": "sites/seema-labs/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agents can modify software, run commands, access tools, and touch development infrastructure, so organizations must decide which authority to delegate."}, {"id": "sites_seema_labs_index_useful_autonomy", "label": "Useful Autonomy", "file_type": "rationale", "source_file": "sites/seema-labs/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Principle 01: AI agents should be able to complete meaningful work."}, {"id": "sites_seema_labs_index_clear_boundaries", "label": "Clear Boundaries", "file_type": "rationale", "source_file": "sites/seema-labs/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Principle 02: authority given to an agent should be defined for its task."}, {"id": "sites_seema_labs_index_human_direction", "label": "Human Direction", "file_type": "rationale", "source_file": "sites/seema-labs/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Principle 03: people and organizations should have a say in what authority is granted."}, {"id": "sites_seema_labs_index_understandable_decisions", "label": "Understandable Decisions", "file_type": "rationale", "source_file": "sites/seema-labs/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Principle 04: permission requests should be clear enough to review."}, {"id": "sites_seema_labs_index_permission_plan", "label": "Permission Plan", "file_type": "concept", "source_file": "sites/seema-labs/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First moment of clarity: a coding task becomes a focused plan that shows which files and actions are relevant and why each permission is requested."}, {"id": "sites_seema_labs_index_human_review", "label": "Human Review", "file_type": "concept", "source_file": "sites/seema-labs/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Second moment of clarity: people review proposed permissions with their reasons and approve or deny the plan. The sample review is a browser-only decision, not a live grant."}, {"id": "sites_seema_labs_index_additional_access", "label": "Additional Access", "file_type": "concept", "source_file": "sites/seema-labs/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Third moment of clarity: more authority deserves a new look. An agent request for extra access returns the reason to a person. A request is a prompt for a decision, not an automatic expansion of scope."}, {"id": "sites_seema_labs_index_policy_controls", "label": "Policy Controls", "file_type": "concept", "source_file": "sites/seema-labs/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Policy controls protect sensitive files. The sample marks .env.production as protected production configuration and warns that a non-sensitive timeout value may be enough."}, {"id": "sites_seema_labs_index_login_timeout_example", "label": "Login Timeout Permission Example", "file_type": "concept", "source_file": "sites/seema-labs/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sample task 'Fix the login timeout bug' proposes read+edit on src/auth/session.ts and tests/auth/session.test.ts plus execute of npm run test:auth. Production secrets stay outside the plan; a separate read of .env.production requires another human review. Illustrative sample data, not a claim that every interface detail ships."}], "edges": [{"source": "sites_seema_labs_index_seema_labs", "target": "sites_seema_labs_index_trinetra", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sites/seema-labs/index.html", "source_location": null, "weight": 1.0}, {"source": "sites_seema_labs_index_trinetra", "target": "sites_seema_labs_index_hosted_trinetra", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sites/seema-labs/index.html", "source_location": null, "weight": 1.0}, {"source": "sites_seema_labs_index_autonomy_not_unlimited_authority", "target": "sites_seema_labs_index_seema_labs", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sites/seema-labs/index.html", "source_location": null, "weight": 1.0}, {"source": "sites_seema_labs_index_nepal", "target": "sites_seema_labs_index_seema_labs", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sites/seema-labs/index.html", "source_location": null, "weight": 1.0}, {"source": "sites_seema_labs_index_seema_labs", "target": "sites_seema_labs_index_