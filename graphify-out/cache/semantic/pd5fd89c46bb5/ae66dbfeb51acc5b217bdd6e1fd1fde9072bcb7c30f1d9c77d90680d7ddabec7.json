{"nodes": [{"id": "sites_trinetra_index_trinetra", "label": "Trinetra", "file_type": "concept", "source_file": "sites/trinetra/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turns a coding task into focused permissions, explains why each permission is needed, and gives people control over approval so teams can make deliberate decisions about what an agent can access and change."}, {"id": "sites_trinetra_index_access_with_intention", "label": "Access with Intention", "file_type": "rationale", "source_file": "sites/trinetra/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Product stance: give coding agents the access their task calls for, with a clear purpose for every permission, and keep people in control."}, {"id": "sites_trinetra_index_ai_coding_agents", "label": "AI Coding Agents", "file_type": "concept", "source_file": "sites/trinetra/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The product exists so teams can decide, with context, what a coding agent may access and change for a focused task."}, {"id": "sites_trinetra_index_permission_plan", "label": "Permission Plan", "file_type": "concept", "source_file": "sites/trinetra/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Permission planning attaches a reason to each proposed file or action. The task is the starting point; the explanation makes the plan reviewable."}, {"id": "sites_trinetra_index_human_review", "label": "Human Review", "file_type": "concept", "source_file": "sites/trinetra/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requested access and its explanation stay together so a person can approve or deny with context. The on-page review is an illustration."}, {"id": "sites_trinetra_index_additional_access", "label": "Additional Access", "file_type": "concept", "source_file": "sites/trinetra/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New access starts a new conversation. When an agent asks for more authority, a person reviews what changed and why. A request for more access is a decision to review."}, {"id": "sites_trinetra_index_task_focused_access", "label": "Task-Focused Access", "file_type": "rationale", "source_file": "sites/trinetra/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Principle 01: connect the requested authority to the work at hand. A focused task deserves a focused scope; a login fix may need a few files, not an entire codebase."}, {"id": "sites_trinetra_index_clear_explanations", "label": "Clear Explanations", "file_type": "rationale", "source_file": "sites/trinetra/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Principle 02: make the purpose of each permission easy to understand."}, {"id": "sites_trinetra_index_human_review_and_approval", "label": "Human Review and Approval", "file_type": "rationale", "source_file": "sites/trinetra/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Principle 03: give people the context and the choice to approve or deny."}, {"id": "sites_trinetra_index_sensitive_file_boundaries", "label": "Boundaries for Sensitive Files", "file_type": "rationale", "source_file": "sites/trinetra/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Principle 04: use policy controls to protect files that need extra care, such as production configuration."}, {"id": "sites_trinetra_index_scope_change_review", "label": "Review When Scope Changes", "file_type": "rationale", "source_file": "sites/trinetra/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Principle 05: bring additional access requests back to a person for a decision."}, {"id": "sites_trinetra_index_start_with_the_task", "label": "Start with the Task", "file_type": "concept", "source_file": "sites/trinetra/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "How-it-works step 01: describe what the coding agent should do. The task gives the permission plan its purpose."}, {"id": "sites_trinetra_index_understand_the_access", "label": "Understand the Access", "file_type": "concept", "source_file": "sites/trinetra/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "How-it-works step 02: inspect the proposed files and actions with a clear explanation of why each is needed."}, {"id": "sites_trinetra_index_make_the_call", "label": "Make the Call", "file_type": "concept", "source_file": "sites/trinetra/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "How-it-works step 03: approve or deny the proposed access, and review a separate request if the agent needs more authority."}, {"id": "sites_trinetra_index_login_timeout_example", "label": "Login Timeout Permission Example", "file_type": "concept", "source_file": "sites/trinetra/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sample task 'Fix the login timeout bug' proposes read+edit on src/auth/session.ts and tests/auth/session.test.ts, execute of npm run test:auth, and shows .env.production as protected. A separate read-only request to compare the production session timeout is reviewed by a person. Interfaces use sample data."}, {"id": "sites_trinetra_index_task_context_flow", "label": "Task Context to Human Judgment", "file_type": "concept", "source_file": "sites/trinetra/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stated path from why Trinetra exists: task context, then clear permissions, then human judgment. A focused task should not imply whole-codebase access."}], "edges": [{"source": "sites_trinetra_index_trinetra", "target": "sites_trinetra_index_ai_coding_agents", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sites/trinetra/index.html", "source_location": null, "weight": 1.0}, {"source": "sites_trinetra_index_access_with_intention", "target": "sites_trinetra_index_trinetra", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sites/trinetra/index.html", "source_location": null, "weight": 1.0}, {"source": "sites_trinetra_index_trinetra", "target": "sites_trinetra_index_permission_plan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sites/trinetra/index.html", "source_location": null, "weight": 1.0}, {"source": "sites_trinetra_index_trinetra", "target": "sites_trinetra_index_human_review", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sites/trinetra/index.html", "source_location": null, "weight": 1.0}, {"source": "sites_trinetra_index_trinetra", "target": "sites_trinetra_index_additional_access", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sites/trinetra/index.html", "source_location": null, "weight": 1.0}, {"source": "sites_trinetra_index_start_with_the_task", "target": "sites_trinetra_index_permission_plan", "relation": "concept